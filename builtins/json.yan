struct JSONLoader[filePath]


JSONLoader.load = function(this)
    this._content = readFile(this.filePath)
    this._index = -1
end


JSONLoader._peek = function(this)
    if this._index + 2 < len(this._content) then
        return this._content[this._index + 1]
    end
    panic('Reach end of stream')
end


JSONLoader._get = function(this)
    var c = this._content[this._index]
    if this._index + 2 < len(this._content) then
        this._index = this._index + 1
    end
    return c
end


